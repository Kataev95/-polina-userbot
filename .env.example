# Скопируйте в .env для ЛОКАЛЬНОГО запуска (на Bothost задаётся в панели!)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
SESSION_STRING=вставьте_строку_сессии_из_gen_session.py

# ID вашего ОСНОВНОГО аккаунта — с него Полина принимает команду .все в ЛС
# и туда же шлёт прогресс. Нужен для тихого тега. Свой ID: напишите @userinfobot.
OWNER_ID=123456789

# Необязательные настройки:
# BOT_NAME=Полина
# TAGALL_LIMIT=200       # максимум людей за один .все
# TAGALL_DELETE_DELAY=1  # пауза перед удалением пачки тегов, сек
# TAGALL_BATCH_PAUSE=1.5 # пауза между пачками, сек
# TTS_VOICE=ru-RU-SvetlanaNeural
# TTS_RATE=+0%
# TTS_MAX_LEN=800
# TIMEZONE=Europe/Moscow
# TAGALL_LIMIT=100
# DATA_DIR=./data
